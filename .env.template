BOT_TOKEN=1234567890:replace_with_bot_token
CHAT_ID=-1000000000000
# ID существующего сообщения в CHAT_ID, которое бот постоянно редактирует.
MESSAGE_ID=2
NODES_API_URL=https://panel.example.com/panel/api/nodes/list
API_KEY=replace_with_api_key
# Telegram user ID администраторов через запятую.
ADMIN_IDS=123456789,987654321
# Необязательно: вычисляется из NODES_API_URL автоматически.
# PANEL_API_URL=https://panel.example.com/panel/api
ADMIN_PAGE_SIZE=8

# Интервал между полными циклами мониторинга.
CHECK_INTERVAL_SECONDS=60
# Пауза перед повторной проверкой доступности из РФ.
CONFIRMATION_DELAY_SECONDS=7
HTTP_TIMEOUT_SECONDS=10
# check-host публикует результаты не сразу.
CHECK_HOST_RESULT_DELAY_SECONDS=8
MAX_CONCURRENT_CHECKS=4
# Оставлено false для совместимости с панелями с самоподписанным сертификатом.
NODES_API_VERIFY_SSL=false
